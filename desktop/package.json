{
  "name": "finhub-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for FinHub",
  "homepage": "https://finhub.ai",
  "author": {
    "name": "FinHub AI",
    "email": "contact@finhub.ai"
  },
  "main": "src/index.js",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "start": "node scripts/write-build-config.mjs && electron .",
    "test": "node --test",
    "preview": "node scripts/preview.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/write-build-config.mjs && node scripts/make-icons.mjs && node scripts/build.mjs --dir",
    "dist": "node scripts/write-build-config.mjs && node scripts/make-icons.mjs && node scripts/build.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.16.1",
    "sharp": "^0.35.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "electron-builder-squirrel-windows": "^26.16.1",
      "plist": "^3.1.1"
    }
  }
}
