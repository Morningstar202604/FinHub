# .gitattributes

*.ipynb linguist-vendored

# Shell scripts and Dockerfiles must use LF so they run inside Linux containers
# even when checked out on Windows with core.autocrlf=true.
*.sh        text eol=lf
Dockerfile  text eol=lf
Dockerfile.* text eol=lf

# Byte-exact test fixtures: the .srcdoc.html files are compared character-for-
# character against LF-joined template output, so they must stay LF on every
# platform or the equality assertion breaks on Windows checkouts.
*.srcdoc.html text eol=lf